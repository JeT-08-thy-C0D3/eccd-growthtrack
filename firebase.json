{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/reset-password",
        "destination": "/reset-password.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "eccd-growthtrack",
          "appId": "1:1092439142532:android:cee5149990187b5f8b52d1",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "eccd-growthtrack",
          "configurations": {
            "android": "1:1092439142532:android:cee5149990187b5f8b52d1",
            "web": "1:1092439142532:web:442cd054c1eb177f8b52d1"
          }
        }
      }
    }
  }
}
