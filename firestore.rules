rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // UTILITY FUNCTIONS
    // ============================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The first profile is created only by the pre-provisioned Firebase Auth
    // account. This lets the app bootstrap without opening user creation to
    // anonymous or arbitrary authenticated users.
    function isInitialAdminProfile(userId) {
      return isAuthenticated() &&
             request.auth.uid == userId &&
             request.auth.token.email == 'delimahenry90@gmail.com' &&
             request.resource.data.email == 'delimahenry90@gmail.com' &&
             request.resource.data.role == 'admin' &&
             request.resource.data.status == 'active' &&
             !('password' in request.resource.data);
    }
    
    function isTeacher() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    
    function isParent() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }
    
    function getUserCenterId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.centerId;
    }

    function isAssignedTeacherForChild(childId) {
      return isTeacher() &&
             get(/databases/$(database)/documents/children/$(childId)).data.teacher_uid == request.auth.uid;
    }

    function isLinkedParentForChild(childId) {
      return isParent() &&
             get(/databases/$(database)/documents/children/$(childId)).data.parent_uid == request.auth.uid;
    }
    
    function userOwnsDocument() {
      return request.auth.uid == resource.data.uid;
    }
    
    // ============================================================================
    // USERS COLLECTION (CRITICAL: No passwords)
    // ============================================================================
    
    match /users/{userId} {
      // Read: Users can read their own profile; admins read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Bootstrap the original admin profile, then allow that admin to create
      // Teacher and Parent profiles. Passwords must never be in Firestore.
      allow create: if isInitialAdminProfile(userId) ||
                       (isAdmin() &&
                        request.resource.data.role in ['teacher', 'parent'] &&
                        !('password' in request.resource.data));
      
      // Update: User can update own profile (except role/status); admin can update all
      allow update: if (request.auth.uid == userId && 
                        !('role' in request.writeFields) && 
                        !('status' in request.writeFields)) || isAdmin();
      
      // Delete: Never from client (only backend deactivates users)
      allow delete: if false;
      
      // Verify no password field exists
      allow read: if !('password' in resource.data);
      
      // Subcollection: User sessions (for timeout tracking)
      match /sessions/{sessionId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // ============================================================================
    // CHILDREN COLLECTION
    // ============================================================================
    
    match /children/{childId} {
      // Read: only the assigned teacher and the linked parent, plus admins.
      allow read: if isAdmin() ||
                      (isTeacher() && resource.data.teacher_uid == request.auth.uid) ||
                      (isParent() && resource.data.parent_uid == request.auth.uid);
      
      // Create: Admin only
      allow create: if isAdmin();
      
      // A teacher or parent may edit only a linked child. Neither may move a
      // child to another teacher/parent; assignment changes are admin-only.
      allow update: if isAdmin() ||
                       ((isAssignedTeacherForChild(childId) ||
                         isLinkedParentForChild(childId)) &&
                        request.resource.data.teacher_uid == resource.data.teacher_uid &&
                        request.resource.data.parent_uid == resource.data.parent_uid);
      
      // Delete: Never (soft-delete via audit)
      allow delete: if false;
      
      // Subcollection: Child assignments
      match /assignments/{assignmentId} {
        allow read: if isAdmin() || isTeacher();
        allow write: if isAdmin();
      }
    }
    
    // ============================================================================
    // EVALUATION SESSIONS & OBSERVATIONS (CORE FUNCTIONALITY)
    // ============================================================================
    
    match /evaluation_sessions/{sessionId} {
      // Read: Teachers (own), Parents (linked child), Admins
      allow read: if isAdmin() || 
                      (isTeacher() && resource.data.evaluatorId == request.auth.uid) ||
                      (isTeacher() && resource.data.centerId == getUserCenterId()) ||
                      isParent();
      
      // Create: Teachers only (must be assigned to child)
      allow create: if isTeacher() && 
                       request.resource.data.evaluatorId == request.auth.uid &&
                       request.resource.data.centerId == getUserCenterId();
      
      // Update: Teacher (own), Admin with verification
      allow update: if (isTeacher() && resource.data.evaluatorId == request.auth.uid) ||
                       (isAdmin() && 'humanVerified' in request.writeFields);
      
      // Delete: Soft-delete via status, never hard-delete
      allow delete: if false;
      
      // Subcollection: Observations (score details)
      match /observations/{observationId} {
        allow read: if isAdmin() || isTeacher() || isParent();
        allow create, update: if isTeacher();
        allow delete: if false;
      }
    }
    
    // ============================================================================
    // REFERRALS (CONFIDENTIAL)
    // ============================================================================
    
    match /referrals/{referralId} {
      // Read: Admin, referring teacher
      allow read: if isAdmin() || 
                      (isTeacher() && resource.data.referrerId == request.auth.uid);
      
      // Create: Teachers only
      allow create: if isTeacher() && 
                       request.resource.data.referrerId == request.auth.uid;
      
      // Update: Teacher (own), Admin
      allow update: if (isTeacher() && resource.data.referrerId == request.auth.uid) ||
                       isAdmin();
      
      // Delete: Never (audit trail)
      allow delete: if false;
    }
    
    // ============================================================================
    // CONSENT RECORDS (GDPR/PRIVACY CRITICAL)
    // ============================================================================
    
    match /consent_records/{recordId} {
      // Read: Admin, relevant parent/user
      allow read: if isAdmin() || request.auth.uid == resource.data.parentId;
      
      // Create: Only by backend Cloud Function (parent initiates, backend verifies)
      allow create: if false;
      
      // Update: Never (immutable audit trail)
      allow update: if false;
      
      // Delete: Never
      allow delete: if false;
    }
    
    // ============================================================================
    // ATTENDANCE EVENTS
    // ============================================================================
    
    match /attendance_events/{eventId} {
      // Read: Teachers (center), Admins
      allow read: if isAdmin() || 
                      (isTeacher() && resource.data.centerId == getUserCenterId());
      
      // Create: Teachers (RFID device or manual)
      allow create: if isTeacher();
      
      // Update: Limited to status corrections by teachers
      allow update: if isTeacher() && 
                       only(['status'], request.writeFields);
      
      // Delete: Never
      allow delete: if false;
    }
    
    // ============================================================================
    // AUDIT LOGS (IMMUTABLE)
    // ============================================================================
    
    match /audit_logs/{logId} {
      // Read: Admin only
      allow read: if isAdmin();
      
      // Admin clients may append a log, but its time must be Firebase's
      // request/server time. This prevents a phone's clock from forging it.
      allow create: if isAdmin() &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.server_created_at == request.time &&
                       request.resource.data.server_updated_at == request.time;
      
      // Update/Delete: Never
      allow update, delete: if false;
    }
    
    // ============================================================================
    // NOTIFICATIONS
    // ============================================================================
    
    match /notifications/{notificationId} {
      // NotificationModel uses recipient_uid and is_read.  Keep support for
      // legacy records while ensuring parents can only read their own inbox.
      allow read: if isAuthenticated() &&
                    (request.auth.uid == resource.data.recipient_uid ||
                     request.auth.uid == resource.data.userId);
      
      // Assigned teachers and administrators may create a notification for a
      // child. The recipient must be the parent currently linked to that child.
      allow create: if isAdmin() ||
                       (isTeacher() &&
                        request.resource.data.recipient_uid ==
                          get(/databases/$(database)/documents/children/$(request.resource.data.child_id)).data.parent_uid &&
                        get(/databases/$(database)/documents/children/$(request.resource.data.child_id)).data.teacher_uid == request.auth.uid);
      
      // A parent can only mark their own notification as read.
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.recipient_uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
      
      allow delete: if false;
    }

    // ============================================================================
    // CLARIFICATION REQUESTS
    // ============================================================================

    match /clarifications/{clarificationId} {
      // Parents may only create requests that are tagged with their own UID.
      allow create: if isParent() &&
                       request.resource.data.parent_uid == request.auth.uid &&
                       request.resource.data.server_created_at == request.time &&
                       request.resource.data.server_updated_at == request.time;

      // Parents can read their own requests; staff can process requests.
      allow read: if isAdmin() || isTeacher() ||
                     (isParent() && resource.data.parent_uid == request.auth.uid);

      // Only staff may add a response/status update.
      allow update: if (isAdmin() || isTeacher()) &&
                       request.resource.data.server_updated_at == request.time;
      allow delete: if false;
    }

    // ============================================================================
    // PARENT FEEDBACK
    // ============================================================================

    match /parent_feedback/{feedbackId} {
      // Parent records use Firebase time; phone time is never accepted as the
      // official created/updated timestamp.
      allow create: if isParent() &&
                       request.resource.data.parent_uid == request.auth.uid &&
                       get(/databases/$(database)/documents/children/$(request.resource.data.child_id)).data.parent_uid == request.auth.uid &&
                       request.resource.data.server_created_at == request.time &&
                       request.resource.data.server_updated_at == request.time;

      allow read: if isAdmin() ||
                      (isParent() && resource.data.parent_uid == request.auth.uid) ||
                      (isTeacher() &&
                       get(/databases/$(database)/documents/children/$(resource.data.child_id)).data.teacher_uid == request.auth.uid);

      allow update: if (isAdmin() ||
                       (isParent() && resource.data.parent_uid == request.auth.uid)) &&
                       request.resource.data.parent_uid == resource.data.parent_uid &&
                       request.resource.data.child_id == resource.data.child_id &&
                       request.resource.data.server_created_at == resource.data.server_created_at &&
                       request.resource.data.server_updated_at == request.time;

      allow delete: if false;
    }
    
    // ============================================================================
    // CATEGORIES (ADMIN MANAGED)
    // ============================================================================
    
    match /categories/{categoryId} {
      // Read: All authenticated users
      allow read: if isAuthenticated();
      
      // Create/Update: Admin only
      allow create, update: if isAdmin();
      
      // Delete: Never (soft-delete via status)
      allow delete: if false;
    }
    
    // ============================================================================
    // ECCD DOMAINS (REFERENCE DATA)
    // ============================================================================
    
    match /eccd_domains/{domainId} {
      // Read: All authenticated users
      allow read: if isAuthenticated();
      
      // Write: Admin only via backend
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================================================
    // CATCH-ALL (DENY BY DEFAULT)
    // ============================================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
// DEPLOYMENT NOTES
// ============================================================================
// 
// 1. Deploy this file as: firestore.rules
// 2. Test with Firebase Emulator Suite before production
// 3. Create Firestore indexes for:
//    - evaluation_sessions: (centerId, sessionDate DESC)
//    - referrals: (centerId, referralDate DESC)
//    - attendance_events: (childId, attendanceDate DESC)
//    - notifications: (userId, createdAt DESC)
// 4. Enable audit logging in Firestore
// 5. Monitor rule violations via Firebase Console
